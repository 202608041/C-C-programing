#include <stdio.h>
int main(void) {
    double x1, y1, x2, y2;
    double centerX, centerY;
    scanf("%lf %lf", &x1, &y1);
    scanf("%lf %lf", &x2, &y2);
    centerX = (x1 + x2) / 2;
    centerY = (y1 + y2) / 2;
    printf("Center point = (%.1f, %.1f)", centerX, centerY);
    return 0;
}
